---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import handsImg from "@/assets/atelier-hands.jpg";
import workshopImg from "@/assets/strandnico.jpg";
---

<BaseLayout
  title="About — Nis Randers"
  description="A small workshop in Småland, Sweden, building furniture by hand from solid oak, ash and walnut. Slow, signed, and made to be repaired."
  image={workshopImg}
>
  <main id="main-content">
  <section class="mx-auto max-w-screen-xl px-6 pb-16 pt-20 md:pb-24 md:pt-28">
    <p class="mb-6 flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
      <span class="inline-block h-px w-8 bg-ink/40"></span>
      Über Nis Randers
    </p>
 
    <h1 class="max-w-[18ch] text-balance font-serif text-5xl leading-[0.95] md:text-7xl">
      Einer nach dem Andern,
    </h1>
    <h1 class="max-w-[18ch] text-balance font-serif text-5xl leading-[0.95] md:text-7xl">
      <span class="italic text-accent"> Masche für Masche,</span>
    </h1>
    <h1 class="max-w-[18ch] text-balance font-serif text-5xl leading-[0.95] md:text-7xl">
      in Ruhe hergestellt.
    </h1>
    <p class="mt-8 max-w-[58ch] text-lg leading-relaxed text-faded">
      Ich fertige zeitlose, einzigartige Fischerpullover - wind- & wetterfeste Ganseys, welche dich ein Leben lang begleiten werden.
    </p>
  </section>

  <section class="relative w-full">
    <Image
      src={workshopImg}
      alt="Sunlit Scandinavian woodworking atelier with hand tools and a half-finished chair"
      width={1920}
      height={1080}
      format="webp"
      loading="eager"
      class="h-[50vh] w-full object-cover md:h-[70vh]"
    />
  </section>

  <section class="mx-auto mt-24 grid max-w-screen-xl gap-10 px-6 md:mt-32 md:grid-cols-12 md:gap-16">
    <div class="md:col-span-5">
      <p class="mb-6 text-[11px] uppercase tracking-[0.3em] text-faded">Est. 2026</p>
      <h2 class="text-balance font-serif text-3xl leading-[1.02] md:text-5xl">Ein Mensch - Ein Gansey.</h2>
    </div>
    <div class="space-y-6 leading-relaxed text-faded md:col-span-6 md:col-start-7">
      <p>
        Die Idee für Nis Randers begann mit der Fertigstellung meines ersten Ganseys.  
      </p>
      <p>
        Die Kollektion ist absichtlich klein. Vier Modelle, 12 Farbtöne. Weniger ist mehr. Lieber kann ich eine Sache richtig gut, als Hunderte anzubieten von denen ich keine wirklich beherrsche.
      </p>
    </div>
  </section>

  <section class="mx-auto mt-24 max-w-screen-xl border-t border-line px-6 pt-12 md:mt-32">
    <p class="mb-12 text-[11px] uppercase tracking-[0.3em] text-faded">Meine Arbeit</p>
    <div class="grid gap-x-8 gap-y-12 md:grid-cols-3">
      {
        [
          {
            n: "01",
            h: "Reine Schurwolle",
            p: "In Yorkshire gesponnenes, 5-fach gezwirntes Kammgarn aus englischer Schafswolle. Das klassische, formstabile Gansey Garn.",
          },
          {
            n: "02",
            h: "Ko-Kreation",
            p: "Gemeinsam entwickeln wir Design und Passsform für deinen Gansey. Skizzen und Musterproben in den verschiedenen Farbgebungen, helfen uns dein Modell zu entwickeln.",
          },
          {
            n: "03",
            h: "Masche für Masche",
            p: "In Ruhe und Hingabe stricke ich den Gansey nur für dich, sodass er sich, nach einigen Wochen, liebevoll verpackt, auf den Weg zu dir machen kann.",
          },
        ].map((block) => (
          <div class="space-y-3">
            <p class="text-[10px] uppercase tracking-[0.3em] text-faded tabular-nums">{block.n}</p>
            <h3 class="font-serif text-2xl">{block.h}</h3>
            <p class="text-sm leading-relaxed text-faded">{block.p}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-24 md:mt-32">
    <div class="mx-auto grid max-w-screen-2xl items-center gap-10 px-6 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-5">
        <div class="aspect-[3/4] overflow-hidden rounded-[min(1vw,12px)] bg-paper">
          <Image
            src={handsImg}
            alt="Close-up of a craftsman's hands planing a piece of pale oak"
            width={1080}
            height={1440}
            format="webp"
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
      <div class="space-y-8 md:col-span-6 md:col-start-7">
        <p class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
          <span class="inline-block h-px w-8 bg-ink/40"></span>
          Über Kleidung
        </p>
        <blockquote class="text-balance font-serif text-3xl leading-[1.15] md:text-4xl">
          "Ich fertige keine Mode. Jeder Gansey wird individuell entworfen —
          <span class="italic text-accent">für den Menschen der ihn tragen wird</span> — und voller Hingabe hergestellt."
        </blockquote>
        <p class="text-xs uppercase tracking-[0.25em] text-faded">— Nico Winkler</p>
        <div class="space-y-3 border-t border-line pt-6 text-sm leading-relaxed text-faded">
          <p>
            Mit feinen 2,75mm Nadeln gestrickt, entstehen über das Jahr maximal zehn feingemusterte, wetterfeste und robuste Ganseys.
          </p>
          <p>
             Ein Mann, zwei Nadeln, Schurwolle, Zeit. Nicht mehr und nicht weniger.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-24 max-w-screen-xl border-y border-line px-6 py-12 md:mt-32">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4">
      {
        [
          { n: "2026", l: "Gegründet" },
          { n: "2", l: "Hände" },
          { n: "1-2", l: "Konen Wolle" },
          { n: "> 4", l: "Wochen Fertigungsdauer" },
        ].map((stat) => (
          <div class="space-y-2">
            <p class="font-serif text-4xl tabular-nums md:text-5xl">{stat.n}</p>
            <p class="text-[10px] uppercase tracking-[0.3em] text-faded">{stat.l}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="studio" class="mx-auto mb-32 mt-12 max-w-screen-xl px-6 md:mt-16">
    <div class="grid items-end gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <h2 class="max-w-[20ch] text-balance font-serif text-3xl leading-[1.02] md:text-5xl">
          Bestell dir deinen Gansey, oder besuch einen Kurs.
        </h2>
      </div>
      <div class="flex flex-col gap-4 sm:flex-row md:col-span-5 md:justify-end">
        <a
          href="/catalog"
          class="inline-flex items-center justify-center gap-3 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent"
        >
          Zur Kollektion →
        </a>
        <a
          href="mailto:workshop@atelier-ko.example"
          class="inline-flex items-center justify-center gap-3 rounded-full px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-ink ring-1 ring-line transition-colors hover:bg-paper"
        >
          Schreib mir
        </a>
      </div>
    </div>
  </section>
  </main>
</BaseLayout>
